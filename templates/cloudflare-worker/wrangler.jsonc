{
  "name": "__WORKER_NAME__",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "r2_buckets": [{ "binding": "MAIL_SPOOL", "bucket_name": "__BUCKET_NAME__" }],
  "durable_objects": { "bindings": [{ "name": "MAIL_QUOTA", "class_name": "SpoolQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpoolQuota"] }],
  "vars": { "MAX_MESSAGE_BYTES": "10485760", "MAX_SPOOL_BYTES": "1073741824", "MAX_SPOOL_MESSAGES": "10000", "RATE_WINDOW_S": "60", "MAX_MESSAGES_PER_WINDOW": "100" }
}
