{% if mail.contact %}- {{ i18n.t('contact') }}: {{ mail.contact.display_name | plain }} (`{{ mail.contact.contact_uid }}`)
{% endif %}{% if mail.subject %}- {{ i18n.t('subject') }}: {{ mail.subject | plain }}
{% endif %}{% if mail.to %}- {{ i18n.t('to') }}: {{ mail.to | map("plain") | join(", ") }}
{% endif %}{% if mail.cc %}- {{ i18n.t('cc') }}: {{ mail.cc | map("plain") | join(", ") }}
{% endif %}{% if mail.bcc %}- {{ i18n.t('bcc') }}: {{ mail.bcc | map("plain") | join(", ") }}
{% endif %}{% if mail.identity_match %}- {{ i18n.t('identity') }}: {% if mail.identity %}{{ mail.identity | plain }}{% else %}{{ mail.identity_match | plain }}{% endif %}{% if mail.identity_email %} {{ mail.identity_email | plain }}{% endif %}{% if mail.identity_candidates %} ({{ i18n.t('candidates') }}: {{ mail.identity_candidates | map("plain") | join(", ") }}){% endif %}{% if mail.observed_recipient_emails %} ({{ i18n.t('observed') }}: {{ mail.observed_recipient_emails | map("plain") | join(", ") }}){% endif %}
{% endif %}{% if analysis.security.authentication_warning %}- {{ i18n.t('warnings') }}:
{% if auth.spf != "pass" %}  - {{ i18n.t('authentication') }}: SPF {% if auth.spf == "missing" %}{{ i18n.t('missing') }}{% else %}{{ i18n.t('did_not_pass') }} ({{ auth.spf }}){% endif %}
{% endif %}{% if auth.dkim != "pass" %}  - {{ i18n.t('authentication') }}: DKIM {% if auth.dkim == "missing" %}{{ i18n.t('missing') }}{% else %}{{ i18n.t('did_not_pass') }} ({{ auth.dkim }}){% endif %}
{% endif %}{% if auth.dmarc != "pass" %}  - {{ i18n.t('authentication') }}: DMARC {% if auth.dmarc == "missing" %}{{ i18n.t('missing') }}{% else %}{{ i18n.t('did_not_pass') }} ({{ auth.dmarc }}){% endif %}
{% endif %}{% if auth.alignment == "mismatch" %}  - {{ i18n.t('authentication') }}: {{ i18n.t('authenticated_domain') }} {% if auth.authenticated_domain %}{{ auth.authenticated_domain | plain }}{% else %}{{ i18n.t('unknown') }}{% endif %} {{ i18n.t('domain_mismatch') }} {{ i18n.t('from_domain') }} {% if auth.from_domain %}{{ auth.from_domain | plain }}{% else %}{{ i18n.t('unknown') }}{% endif %}
{% endif %}{% endif %}{% set security = analysis.security %}{% if security.possible_bcc or security.reply_to_differs or security.sender_differs or mail.list_id or mail.mailing_list_headers %}- {{ i18n.t('notes') }}:
{% if security.possible_bcc %}  - {{ i18n.t('possible_bcc') }}
{% endif %}{% if security.reply_to_differs %}  - {{ i18n.t('reply_to_differs') }}: {{ mail.reply_to | map("plain") | join(", ") }}
{% endif %}{% if security.sender_differs %}  - {{ i18n.t('sender_differs') }}: {{ mail.sender | plain }}
{% endif %}{% if mail.list_id %}  - {{ i18n.t('mailing_list') }}: {{ mail.list_id | plain }}
{% elif mail.mailing_list_headers %}  - {{ i18n.t('mailing_list_headers') }}: {{ mail.mailing_list_headers | map("plain") | join(" | ") }}
{% endif %}{% endif %}

