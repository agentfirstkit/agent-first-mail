{%- import "i18n/catalog.j2" as i18n -%}
{%- set mail = document.message -%}
{%- set analysis = document.analysis -%}
{%- set authored = analysis.body.segments | selectattr("kind", "equalto", "authored") | first -%}
{%- set authored_text = mail.body_text | text_range(authored.start_bytes, authored.end_bytes) if authored else '' -%}
{%- set auth = mail.authentication -%}
{%- if analysis.direction == 'inbound' %}{% set message_time = mail.received_rfc3339 or mail.sent_rfc3339 %}{% else %}{% set message_time = mail.sent_rfc3339 or mail.received_rfc3339 %}{% endif -%}
### {% if analysis.direction == 'inbound' %}{{ i18n.t('received_from') }}{% else %}{{ i18n.t('sent_to') }}{% endif %} {% if analysis.direction == 'inbound' %}{% if mail.from %}{{ mail.from | inline }}{% else %}{{ i18n.t('unknown') }}{% endif %}{% else %}{% if mail.to %}{{ mail.to | map("inline") | join(", ") }}{% else %}{{ i18n.t('unknown') }}{% endif %}{% endif %} - {% if message_time %}{{ message_time | datetime }}{% else %}{{ i18n.t('unknown_time') }}{% endif %}

- {{ i18n.t('message') }}: {% if message_link is defined and message_link %}[`{{ mail.message_id }}`]({{ message_link }}){% else %}`{{ mail.message_id }}`{% endif %}
