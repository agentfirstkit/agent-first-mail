{%- import "i18n/catalog.j2" as i18n -%}
{#- Blocks come as data (see MarkdownBlock in the render document); this macro is the only
    place the Review page turns them into markup, with every value autoescaped. -#}
{%- macro markdown_blocks(blocks) -%}{% for block in blocks %}{% if block.kind == 'rule' %}<hr>{% elif block.kind == 'code' %}<pre class="md-code">{% for run in block.runs %}{{ run.text }}{% endfor %}</pre>{% else %}<p class="md-{{ block.kind }}">{% if block.marker %}<span class="md-marker">{{ block.marker }}</span> {% endif %}{% for run in block.runs %}{% if run.href %}<span class="md-link" role="link" tabindex="0" data-afmail-href="{{ run.href }}"{% if run.host %} data-afmail-host="{{ run.host }}"{% endif %}>{% endif %}{% if run.code %}<code>{% endif %}{% if run.strong %}<strong>{% endif %}{% if run.emphasis %}<em>{% endif %}{{ run.text }}{% if run.emphasis %}</em>{% endif %}{% if run.strong %}</strong>{% endif %}{% if run.code %}</code>{% endif %}{% if run.href %}</span>{% endif %}{% if run.host %}<span class="link-host{% if run.sender_domain_match == false %} foreign{% endif %}"{% if run.sender_domain_match == false %} title="{{ i18n.t('link_foreign_domain') }}"{% endif %}>↗ {{ run.host }}</span>{% endif %}{% endfor %}</p>{% endif %}{% endfor %}{%- endmacro -%}
{% set mail = message_document.message %}{% set analysis = message_document.analysis %}{% if analysis.direction == 'inbound' %}{% set message_time = mail.received_rfc3339 or mail.sent_rfc3339 %}{% else %}{% set message_time = mail.sent_rfc3339 or mail.received_rfc3339 %}{% endif %}<div class="message-entry">
  <details class="message-card {% if analysis.direction == 'outbound' %}outbound{% else %}inbound{% endif %}"{% if message_expanded %} open{% endif %}>
    <summary class="message-header">
      <span class="avatar" aria-hidden="true">{{ (mail.from or mail.identity_email or '') | initials }}</span>
      <span class="message-summary">
        <span class="sender">{% if analysis.direction == 'outbound' %}{{ i18n.t('you') }}{% elif mail.from %}{{ mail.from | display_name }}{% else %}{{ i18n.t('unknown_sender') }}{% endif %}</span>
        <span class="message-address">{% if analysis.direction == 'outbound' %}{{ mail.to | join(', ') }}{% elif mail.from %}{{ mail.from }}{% endif %}</span>
        {% if mail.subject %}<span class="message-subject">{{ mail.subject }}</span>{% endif %}
      </span>
      <time class="message-time" datetime="{{ message_time or '' }}">{% if message_time %}{{ message_time | datetime }}{% else %}{{ i18n.t('unknown_time') }}{% endif %}</time>
    </summary>
    {% if analysis.security.authentication_warning %}<p class="authentication-warning" role="note">{{ i18n.t('auth_attention') }}: SPF {{ mail.authentication.spf }}, DKIM {{ mail.authentication.dkim }}, DMARC {{ mail.authentication.dmarc }}{% if mail.authentication.alignment == 'mismatch' %}; {{ i18n.t('sender_domains_not_align') }}{% endif %}.</p>{% endif %}
    {% if mail.body_markdown and analysis.body_markdown and analysis.body_markdown.authored %}<div class="message-body message-body-markdown">{{ markdown_blocks(analysis.body_markdown.authored) }}{% if analysis.body_markdown.quoted %}<details class="quoted-message"><summary>{{ i18n.t('show_quoted_text') }}</summary><div class="quoted-body">{{ markdown_blocks(analysis.body_markdown.quoted) }}</div></details>{% endif %}</div>
    {% else %}<div class="message-body">{% if analysis.body.segments %}{% for segment in analysis.body.segments %}{% if segment.kind == 'authored' %}<div>{{ mail.body_text | text_range(segment.start_bytes, segment.end_bytes) }}</div>{% endif %}{% endfor %}{% set quoted_segment = analysis.body.segments | selectattr('kind', 'equalto', 'quoted') | first %}{% if quoted_segment %}<details class="quoted-message"><summary>{{ i18n.t('show_quoted_text') }}</summary><div class="quoted-body">{% for segment in analysis.body.segments %}{% if segment.kind == 'quoted' %}<div>{{ mail.body_text | text_range(segment.start_bytes, segment.end_bytes) }}</div>{% endif %}{% endfor %}</div></details>{% endif %}{% else %}<div>{{ i18n.t('no_readable_body') }}</div>{% endif %}</div>{% endif %}
    {% if mail.attachments %}<div class="attachment-list" aria-label="{{ i18n.t('attachments') }}">{% for attachment in mail.attachments %}<div class="attachment"><span>{{ attachment.filename }}</span><span class="message-address">{{ attachment.content_type }} · {{ attachment.size_bytes | bytes }}</span>{% if attachment.content_type | is_safe_review_image %}<img class="attachment-preview" data-afmail-attachment-preview data-afmail-message-id="{{ mail.message_id }}" data-afmail-part-id="{{ attachment.part_id }}" alt="{{ attachment.filename }}" loading="lazy" decoding="async">{% endif %}</div>{% endfor %}</div>{% endif %}
    <details class="message-details">
      <summary>{{ i18n.t('message_details') }}</summary>
      <div class="detail-grid">
        <span class="detail-label">{{ i18n.t('message_id') }}</span><span>{{ mail.message_id }}</span>
        {% if mail.from %}<span class="detail-label">{{ i18n.t('from') }}</span><span>{{ mail.from }}</span>{% endif %}
        {% if mail.to %}<span class="detail-label">{{ i18n.t('to') }}</span><span>{{ mail.to | join(', ') }}</span>{% endif %}
        {% if mail.cc %}<span class="detail-label">{{ i18n.t('cc') }}</span><span>{{ mail.cc | join(', ') }}</span>{% endif %}
        {% if analysis.security.reply_to_differs %}<span class="detail-label">{{ i18n.t('reply_to') }}</span><span>{{ mail.reply_to | join(', ') }}</span>{% endif %}
        {% if mail.list_id %}<span class="detail-label">{{ i18n.t('mailing_list') }}</span><span>{{ mail.list_id }}</span>{% endif %}
      </div>
    </details>
  </details>
</div>
