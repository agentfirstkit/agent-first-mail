:root {
  color-scheme: light dark;
  --bg: #f5f3ef;
  --panel: #fffdf9;
  --ink: #22201d;
  --muted: #6d675f;
  --line: #ddd7ce;
  --accent: #2563eb;
  --accent-ink: #fff;
  --warn: #a33b20;
  --soft: #ece8e1;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
[hidden] { display: none !important; }
.app-bar {
  position: sticky; top: 0; z-index: 10; display: flex; align-items: center;
  justify-content: space-between; gap: 1rem; padding: .8rem max(1rem, calc((100vw - 960px) / 2));
  border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--panel) 94%, transparent);
  backdrop-filter: blur(12px);
}
.brand { display: flex; align-items: center; gap: .65rem; }
.brand-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .55rem; background: var(--ink); color: var(--panel); font-weight: 800; }
.brand small, .muted, .message-address, .message-time, .save-state { color: var(--muted); }
.app-actions { display: flex; align-items: center; gap: .65rem; }
.local-pill, .tag { border: 1px solid var(--line); border-radius: 999px; padding: .25rem .55rem; color: var(--muted); font-size: .82rem; }
main { width: min(960px, calc(100% - 2rem)); margin: 2rem auto 5rem; }
.review-heading { margin-bottom: 1.5rem; }
.review-heading h1 { margin: 0 0 .35rem; font-size: clamp(1.65rem, 4vw, 2.35rem); }
.panel, .message-card { border: 1px solid var(--line); border-radius: 1rem; background: var(--panel); box-shadow: 0 10px 30px rgba(40, 35, 25, .05); }
.panel { padding: 1.1rem; margin: 1rem 0; }
.message-entry { margin: 1rem 0; }
.message-card { overflow: hidden; }
.message-card.outbound { margin-left: clamp(0rem, 7vw, 4rem); border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); }
.message-header { display: grid; grid-template-columns: auto 1fr auto; gap: .75rem; align-items: center; padding: 1rem 1rem .6rem; }
.avatar { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--soft); font-weight: 700; }
.sender, .message-subject { margin: 0; }
.message-subject { padding: .35rem 1rem; font-size: 1rem; }
.message-body { padding: .7rem 1rem 1rem; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.55; }
.quoted-body { margin-top: .75rem; padding-left: 1rem; border-left: 3px solid var(--line); color: var(--muted); }
.message-details { border-top: 1px solid var(--line); padding: .75rem 1rem; }
.detail-grid { display: grid; grid-template-columns: max-content 1fr; gap: .35rem .8rem; margin-top: .7rem; overflow-wrap: anywhere; }
.detail-label { color: var(--muted); }
.authentication-warning { margin: .5rem 1rem; padding: .65rem .75rem; border-radius: .6rem; background: color-mix(in srgb, var(--warn) 10%, transparent); color: var(--warn); }
.attachment-list { display: grid; gap: .4rem; padding: 0 1rem 1rem; }
.attachment { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem .7rem; border-radius: .55rem; background: var(--soft); }
.suggestion { border-left: 4px solid var(--accent); }
.suggestion blockquote { margin: .6rem 0; color: var(--muted); }
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
label { display: grid; gap: .35rem; color: var(--muted); }
input, select, textarea { width: 100%; border: 1px solid var(--line); border-radius: .6rem; padding: .65rem .75rem; background: var(--panel); color: var(--ink); }
textarea { min-height: 7rem; resize: vertical; line-height: 1.45; }
.editor-body { min-height: 17rem; }
.save-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: .5rem; }
.save-state[data-state="error"] { color: var(--warn); }
.choice-row { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .8rem; }
.choice-row label { display: flex; align-items: center; gap: .4rem; }
.choice-row input { width: auto; }
.draft-picker { display: flex; gap: .45rem; overflow-x: auto; margin: 1rem 0; }
.draft-picker button, .secondary-action { border: 1px solid var(--line); border-radius: .6rem; padding: .55rem .8rem; background: var(--panel); color: var(--ink); }
.draft-picker button[aria-selected="true"] { border-color: var(--accent); color: var(--accent); }
.primary-action { border: 0; border-radius: .6rem; padding: .6rem .95rem; background: var(--accent); color: var(--accent-ink); font-weight: 650; }
.primary-action:disabled { opacity: .45; cursor: not-allowed; }
.app-action-status { color: var(--warn); font-size: .85rem; max-width: 24rem; }
.complete { text-align: center; padding: 5rem 1rem; }
.destructive-confirmation { margin-top: .8rem; color: var(--warn); }
.destructive-confirmation input { width: auto; }
@media (max-width: 680px) {
  .app-bar { align-items: flex-start; }
  .local-pill { display: none; }
  .app-actions { flex-wrap: wrap; justify-content: flex-end; }
  .app-action-status { width: 100%; text-align: right; }
  .field-grid { grid-template-columns: 1fr; }
  .message-header { grid-template-columns: auto 1fr; }
  .message-time { grid-column: 2; }
}
