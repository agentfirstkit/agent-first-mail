{%- import "i18n/catalog.j2" as i18n -%}
{% set draft = draft_state.document %}{% set locator = draft.locator %}{% set source = draft.draft %}{% set frontmatter = source.frontmatter %}{% set analysis = draft.analysis %}<details class="draft-card"{% if draft_expanded %} open{% endif %}>
  <summary class="draft-header">
    <span class="avatar" aria-hidden="true">↩</span>
    <span class="message-summary">
      <span class="sender">{{ i18n.t('reply_title') }}</span>
      {% if frontmatter.to %}<span class="message-address">{{ i18n.t('to') }} · {{ frontmatter.to | join(', ') }}</span>{% endif %}
      {% if frontmatter.subject %}<span class="message-subject">{{ frontmatter.subject }}</span>{% endif %}
    </span>
    <span class="draft-state">{{ i18n.t('local_draft') }}</span>
  </summary>
  <form class="editor-form draft-editor" data-afmail-autosave="draft">
    <input type="hidden" name="base_hash" value="{{ draft_state.base_hash }}" data-afmail-base-hash>
    <input type="hidden" name="draft_name" value="{{ locator.draft_name }}">
    <p class="muted">{{ i18n.t('autosave_workspace') }} {{ i18n.t('quote_unchanged') }}</p>
    {% if frontmatter.reply_route %}
    <p class="muted">{{ i18n.t('channel_conversation') }}: {{ frontmatter.reply_route.source_id }} / {{ frontmatter.reply_route.conversation_id }}</p>
    <label><span>{{ i18n.t('recipient_ids_one_per_line') }}</span><textarea name="to" rows="2" autocomplete="off">{{ frontmatter.to | join('\n') }}</textarea></label>
    {% else %}
    <label><span>{{ i18n.t('to') }}</span><input name="to" value="{{ frontmatter.to | join(', ') }}" autocomplete="off" inputmode="email"></label>
    <details class="draft-recipient-details"{% if frontmatter.cc %} open{% endif %}>
      <summary>{{ i18n.t('cc') }}</summary>
      <input name="cc" value="{{ frontmatter.cc | join(', ') }}" autocomplete="off" aria-label="{{ i18n.t('cc') }}">
    </details>
    <details class="draft-recipient-details"{% if frontmatter.bcc %} open{% endif %}>
      <summary>{{ i18n.t('bcc') }}</summary>
      <input name="bcc" value="{{ frontmatter.bcc | join(', ') }}" autocomplete="off" aria-label="{{ i18n.t('bcc') }}">
    </details>
    {% endif %}
    <label><span>{{ i18n.t('subject') }}</span><input name="subject" value="{{ frontmatter.subject or '' }}"></label>
    <label><span>{{ i18n.t('message_editor') }}</span><textarea class="editor-body" name="body">{{ source.body_markdown | text_range(analysis.authored_body_range.start_bytes, analysis.authored_body_range.end_bytes) }}</textarea></label>
    {% if frontmatter.attachments %}<div class="attachment-list" aria-label="{{ i18n.t('draft_attachments') }}">{% for attachment_path in frontmatter.attachments %}{% set attachment = analysis.attachments[loop.index0] %}<div class="attachment"><span>{{ attachment_path }}</span><span class="message-address">{% if attachment.exists %}{{ attachment.size_bytes | bytes }}{% else %}{{ i18n.t('missing_attachment') }}{% endif %}</span></div>{% endfor %}</div>{% endif %}
    <span class="save-state draft-save-state" data-afmail-save-status aria-live="polite"></span>
  </form>
</details>
