{%- import "i18n/catalog.j2" as i18n -%}
{% set notes = notes_state.document %}<details class="draft-card notes-card"{% if notes.text %} open{% endif %}>
  <summary class="draft-header">
    <span class="avatar" aria-hidden="true">✎</span>
    <span class="message-summary">
      <span class="sender">{{ i18n.t('notes') }}</span>
      <span class="message-address">{{ i18n.t('private_markdown_notes') }}</span>
    </span>
    <span class="draft-state">{{ i18n.t('local_workspace_only') }}</span>
  </summary>
  <form class="editor-form draft-editor notes-editor" data-afmail-autosave="notes">
    <input type="hidden" name="base_hash" value="{{ notes_state.base_hash }}" data-afmail-base-hash>
    <label><span>{{ i18n.t('notes') }}</span><textarea class="editor-body" name="text">{{ notes.text }}</textarea></label>
    <div class="save-row"><span class="muted">{{ notes.notes_path }}</span><span class="save-state" data-afmail-save-status aria-live="polite"></span></div>
  </form>
</details>
