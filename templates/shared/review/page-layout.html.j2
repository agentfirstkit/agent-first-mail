{%- import "i18n/catalog.j2" as i18n -%}
{% if surface_kind == 'triage_review' %}{% set page_title = i18n.t('triage_review') %}{% elif surface_kind == 'case_review' %}{% set page_title = i18n.t('case_review') %}{% elif surface_kind == 'notification_review' %}{% set page_title = i18n.t('notification_review') %}{% else %}{% set page_title = i18n.t('draft_review') %}{% endif %}<!doctype html>
<html lang="{{ i18n.t('language_bcp47') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }} · afmail</title>
  <link rel="icon" href="{{ afui.app_icon_path }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ afui.base_style_path }}">
  <style>{% include "review/style.css.j2" %}</style>
</head>
<body data-afmail-review
  data-copy-pending="{{ i18n.t('saving_edits') }}"
  data-copy-saving="{{ i18n.t('saving') }}"
  data-copy-saved="{{ i18n.t('saved_locally') }}"
  data-copy-save-error="{{ i18n.t('save_error') }}"
  data-copy-conflict="{{ i18n.t('save_conflict') }}"
  data-copy-confirmation="{{ i18n.t('confirm_destructive') }}"
  data-copy-settling="{{ i18n.t('settling') }}"
  data-copy-settled="{{ i18n.t('item_settled') }}"
  data-copy-settled-repair-required="{{ i18n.t('settled_repair_required') }}"
  data-copy-settle-error="{{ i18n.t('settle_error') }}"
  data-copy-channel-connecting="{{ i18n.t('agent_connecting') }}"
  data-copy-channel-live="{{ i18n.t('agent_live') }}"
  data-copy-channel-waiting="{{ i18n.t('agent_waiting') }}"
  data-copy-channel-disconnected="{{ i18n.t('agent_disconnected') }}"
  data-copy-channel-error="{{ i18n.t('agent_channel_error') }}"
  data-copy-link-copied="{{ i18n.t('link_copied') }}"
  data-copy-link-opened="{{ i18n.t('link_opened') }}"
  data-copy-link-open-failed="{{ i18n.t('link_open_failed') }}">
  <header class="app-bar">
    <div class="brand" aria-label="afmail {{ i18n.t('review') }}"><span class="brand-mark" aria-hidden="true">af</span><span><strong>afmail</strong><br><small>{{ page_title }}</small></span></div>
    <div class="app-actions">
      <span class="local-pill">{{ i18n.t('local_workspace_only') }}</span>
      <span class="app-action-status" data-afmail-status aria-live="polite"></span>
    </div>
  </header>
  <main data-afmail-review-content>
    {% if surface_kind == 'triage_review' %}
    <section class="review-heading"><h1>{{ i18n.t('triage') }}</h1><p class="muted">{{ i18n.t('triage_description') }}</p>{% if contents.truncated %}<p class="muted">{{ i18n.triage_truncated(contents.truncated.returned_count, contents.truncated.count) }}</p>{% endif %}</section>
    {% for item in contents.items %}
      {% set document = item.document %}
      {% with message_document = document.context.message, message_expanded = true %}{% include "review/message.html.j2" %}{% endwith %}
    {% endfor %}
    {% include "review/agent-workbench-layout.html.j2" %}
    {% elif surface_kind == 'case_review' %}
    {% set case_document = contents.collection %}{% set case = case_document.collection %}
    <section class="review-heading"><h1>{{ case.collection_name }}</h1><p class="muted">{{ i18n.t('case') }} {{ case.collection_uid }} · {{ i18n.message_count(case_document.messages | length) }}{% if case_document.location %} · {{ case_document.location.group }}{% endif %}</p></section>
    <section class="review-section" aria-labelledby="case-conversation-heading">
      <header class="section-heading"><h2 id="case-conversation-heading">{{ i18n.t('conversation') }}</h2></header>
      {% for document in case_document.messages %}{% with message_document = document, message_expanded = loop.last %}{% include "review/message.html.j2" %}{% endwith %}{% endfor %}
    </section>
    <section class="review-section" aria-labelledby="case-drafts-heading">
      <header class="section-heading"><h2 id="case-drafts-heading">{{ i18n.t('drafts') }}</h2></header>
      {% if contents.drafts %}{% for draft_state in contents.drafts %}{% with draft_expanded = loop.first %}{% include "review/draft-editor.html.j2" %}{% endwith %}{% endfor %}{% elif case.status %}<section class="panel"><p>{{ i18n.t('archived_no_drafts') }}</p></section>{% else %}<section class="panel"><p>{{ i18n.t('no_drafts') }}</p></section>{% endif %}
    </section>
    {% with notes_state = contents.notes %}{% include "review/notes-editor.html.j2" %}{% endwith %}
    {% include "review/agent-workbench-layout.html.j2" %}
    {% elif surface_kind == 'notification_review' %}
    {% set notification_document = contents.collection %}{% set notification = notification_document.collection %}
    <section class="review-heading"><h1>{{ notification.collection_name }}</h1><p class="muted">{{ i18n.t('notification') }} {{ notification.collection_uid }} · {{ i18n.message_count(notification_document.messages | length) }}</p></section>
    <section class="review-section" aria-labelledby="notification-conversation-heading">
      <header class="section-heading"><h2 id="notification-conversation-heading">{{ i18n.t('conversation') }}</h2></header>
      {% for document in notification_document.messages %}{% with message_document = document, message_expanded = loop.last %}{% include "review/message.html.j2" %}{% endwith %}{% endfor %}
    </section>
    {% with notes_state = contents.notes %}{% include "review/notes-editor.html.j2" %}{% endwith %}
    {% include "review/agent-workbench-layout.html.j2" %}
    {% else %}
    <section class="review-heading"><h1>{{ i18n.t('draft_review') }}</h1><p class="muted">{{ i18n.t('draft_review_description') }}</p></section>
    {% with draft_state = contents.draft, draft_expanded = true %}{% include "review/draft-editor.html.j2" %}{% endwith %}
    {% include "review/agent-workbench-layout.html.j2" %}
    {% endif %}
  </main>
  <dialog class="link-panel" data-afmail-link-panel>
    <h3>{{ i18n.t('link_destination') }}</h3>
    <div class="link-panel-host" data-afmail-link-host></div>
    <div class="link-panel-url" data-afmail-link-url></div>
    <div class="link-panel-actions">
      <button type="button" class="primary-action" data-afmail-link-open>{{ i18n.t('link_open_in_browser') }}</button>
      <button type="button" data-afmail-link-copy>{{ i18n.t('link_copy') }}</button>
      <span class="save-state" data-afmail-link-status aria-live="polite"></span>
      <button type="button" data-afmail-link-close>{{ i18n.t('link_close') }}</button>
    </div>
  </dialog>
  <!-- afmail:trusted-runtime -->
</body>
</html>
