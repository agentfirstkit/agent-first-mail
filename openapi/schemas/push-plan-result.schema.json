            "items": true,
            "type": "array"
          },
          "message_content_hashes": {
            "items": true,
            "type": "array"
          },
          "message_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "message_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "outbound": true,
