      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "skipped_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "skipped_items": {
      "items": {
        "properties": {
          "push_id": {
            "type": "string"
          },
          "queue_item_hash": {
            "type": "string"
