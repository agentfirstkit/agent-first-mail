              "type": "string"
            },
            "type": "array"
          },
          "attempt_count": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "audit_pending": {
            "type": "boolean"
          },
          "case_uid": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_kind": {
            "type": "string"
          },
          "draft_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "effect_scope": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
